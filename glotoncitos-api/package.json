{
  "name": "glotoncitos-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node --test --experimental-test-module-mocks --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test --experimental-test-module-mocks test/login.test.js",
    "test:tiempos": "node --test --experimental-test-module-mocks test/tiempos-respuesta.test.js",
    "lint": "eslint src test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
